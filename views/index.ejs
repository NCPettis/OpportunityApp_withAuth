<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Opportunity App</title>
  <link rel="shortcut icon" href="favicon.ico">
  <link rel="stylesheet" href="font-awesome.min.css">
  <!-- <link rel="stylesheet" href="styles.css"> -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"

>
</head>
<body>
  <h1>Opportunity App</h1>
  <p>Bring some structure to the job hunt. “Because the callback you forgot about might be the opportunity you’ve been waiting for.”</p>
  <p>Ever get a callback a month later and struggle to remember which position you applied for? Opportunity App helps you keep track of every opportunity, application status, and important detail—all in one place.</p>


  <h3>My Job Board</h3>

  <div class="jobBoard">
    <table>
      <thead>
        <tr>
          <th> Position</th>
          <th> Pay </th>
          <th> Company</th>
          <th> Link</th>
          <th> Applied</th>
          <th> Notes </th>
        </tr>
      </thead>
      <tbody>
        <% for(var i=0; i<messages.length; i++) {%>
          <tr data-id="<%= messages[i]._id %>">
            <td><%= messages[i].position %></td>
            <td><%= messages[i].pay %></td>
            <td><%= messages[i].company %></td>
            <td><a href="<%= messages[i].link %>" target="blank" rel="noopener"></a></td>
            <td>
              <select class="dropdown" data-id=<%= messages[i]._id %>
                <% ['Not Yet', 'Yes', 'No', 'No Longer Accepting Apps'].forEach(opt => { %>
                <option value="<%= opt %>" <%= messages[i].apply === opt ? 'selected' : '' %>><%= opt %></option>
                <% }) %>
              </select>
            </td>
            <td><%= messages[i].notes %></td>
            <td><i class="fa fa-trash" aria-hidden="true"></i></td>
          </tr>
        <% } %>
      </tbody>        
    </table>
  </div>


  <h2>Add New Potential Role</h2>

  <form action="/messages" method="POST">
    <input type="text" placeholder="Position" name="position">
    <input type="text" placeholder="Pay Range" name="pay">
    <input type="text" placeholder="Company" name="company">
    <input type="url" placeholder="link to posting" name="link">
    <label for="apply">Did you apply?</label>
      <select name="apply" id="apply">
        <option value="Not Yet">Not Yet</option>
        <option value="Yes">Yes</option>
        <option value="No">No</option>
        <option value="No Longer Accepting Apps">No Longer Accepting Apps</option>
      </select>
    <input type="text" placeholder="Notes" name="notes">
    <button type="submit">Submit</button>
  </form>

  <script src="main.js"></script>

</body>
</html>
